# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="VR Inspector"

# Auth0 (identity provider). Placeholders only — never commit real tenant values
# beyond what is already public in the SPA. Backend verifies access tokens
# against https://${AUTH0_DOMAIN}/.well-known/jwks.json for the API audience.
AUTH0_DOMAIN=example.us.auth0.com
AUTH0_API_AUDIENCE=https://api.example.com
# Frontend (Vite build-time): the SPA application's domain / client id / audience
VITE_AUTH0_DOMAIN=example.us.auth0.com
VITE_AUTH0_CLIENT_ID=changethis
VITE_AUTH0_AUDIENCE=https://api.example.com

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
