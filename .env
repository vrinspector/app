# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="VR Inspector"

# Auth0 (identity provider). Placeholders only — never commit real tenant values
# beyond what is already public in the SPA. Backend verifies access tokens
# against https://${AUTH0_DOMAIN}/.well-known/jwks.json for the API audience.
AUTH0_DOMAIN=example.us.auth0.com
AUTH0_API_AUDIENCE=https://api.example.com
# Frontend (Vite build-time): the SPA application's domain / client id / audience
VITE_AUTH0_DOMAIN=example.us.auth0.com
VITE_AUTH0_CLIENT_ID=changethis
VITE_AUTH0_AUDIENCE=https://api.example.com

# S3 (Hard Rule 8: file storage is S3 only). Bucket/region are configuration;
# AWS credentials come from the runtime (instance role / AWS_* env) — never here.
S3_BUCKET=vrinspector-files
AWS_REGION=us-east-1

# Emails (increment 13.5). Local dev / CI: Mailpit on localhost:1025, no TLS,
# web inbox at http://localhost:8025. Production (owner action at RG-3, never
# committed): AWS SES SMTP, e.g.
#   SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587  SMTP_TLS=True
#   SMTP_USER=<SES SMTP username>  SMTP_PASSWORD=<SES SMTP password>
#   EMAILS_FROM_EMAIL=<address on the SES-verified domain>
#   APP_PUBLIC_URL=<public URL of the web app, used for links in emails>
# Optional: EMAILS_FROM_NAME, EMAILS_REPLY_TO, SES_CONFIGURATION_SET.
# Leave SMTP_HOST empty to turn sending off (emails are logged as "skipped").
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
